# Copy to .env.local (already gitignored).

# Backend API URL. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project settings (Project Settings > API in the Supabase dashboard).
# Auth, onboarding, dashboard, and chat all no-op/redirect to /login without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
