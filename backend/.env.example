# Copy to .env (gitignored). Leave ANTHROPIC_API_KEY unset to run chat in stub mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Comma-separated extra origins allowed to call this API, on top of the
# localhost:3000 default (e.g. your deployed Vercel URL). Leave unset for
# local dev.
CORS_ORIGINS=
