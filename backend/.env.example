# Copy to .env (gitignored). Leave ANTHROPIC_API_KEY unset to run chat in stub mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Comma-separated extra origins allowed to call this API, on top of the
# localhost:3000 default (e.g. your deployed Vercel URL). Leave unset for
# local dev.
CORS_ORIGINS=

# Same Supabase project the frontend uses — needed so /api/chat/reply can
# verify the caller's session and enforce the free-tier daily message limit
# server-side (the frontend's own count is just UX, not security). Only the
# public anon key is needed here, never the service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
