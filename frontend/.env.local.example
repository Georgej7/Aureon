# Copy to .env.local (already gitignored).

# Backend API URL. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project settings (Project Settings > API in the Supabase dashboard).
# Auth, onboarding, dashboard, and chat all no-op/redirect to /login without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key (Project Settings > API > service_role, "secret" tab).
# Server-only — used exclusively by app/api/webhooks/paddle to update a user's
# subscription after a Paddle event, since a webhook has no user session/cookies
# to authenticate as. NEVER prefix this with NEXT_PUBLIC_ or expose it client-side;
# it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Paddle (Developer Tools > Authentication for API keys, Developer Tools >
# Notifications for the webhook secret, Catalog > Products for the price ID).
# Client-side token — public by design, powers the Paddle.js overlay checkout.
# Use a sandbox token (pref. "test_") while testing, swap to live for production.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" (default, free to test with) or "production".
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Price ID for the Premium ($14.99/mo) recurring price (starts with "pri_").
NEXT_PUBLIC_PADDLE_PREMIUM_PRICE_ID=
# Secret API key — server-only, powers webhook signature verification.
PADDLE_API_KEY=
# Notification (webhook) destination secret for the endpoint pointing at
# /api/webhooks/paddle (starts with "pdl_ntfset_" or similar).
PADDLE_WEBHOOK_SECRET=
