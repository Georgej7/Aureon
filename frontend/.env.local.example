# Copy to .env.local (already gitignored).

# Backend API URL. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project settings (Project Settings > API in the Supabase dashboard).
# Auth, onboarding, dashboard, and chat all no-op/redirect to /login without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key (Project Settings > API > service_role, "secret" tab).
# Server-only — used exclusively by app/api/webhooks/paddle to update a user's
# subscription after a Paddle event, since a webhook has no user session/cookies
# to authenticate as. NEVER prefix this with NEXT_PUBLIC_ or expose it client-side;
# it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Paddle (Developer Tools > Authentication for API keys, Developer Tools >
# Notifications for the webhook secret, Catalog > Products for the price ID).
# Client-side token — public by design, powers the Paddle.js overlay checkout.
# Use a sandbox token (pref. "test_") while testing, swap to live for production.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" (default, free to test with) or "production".
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Price ID for the Premium ($14.99/mo) recurring price (starts with "pri_").
NEXT_PUBLIC_PADDLE_PREMIUM_PRICE_ID=
# Price ID for the Premium ($149/yr) recurring price (starts with "pri_").
# Leave unset and the pricing page's Annual toggle shows a graceful
# "not available yet" error instead of failing checkout.
NEXT_PUBLIC_PADDLE_PREMIUM_ANNUAL_PRICE_ID=
# VIP price IDs ($59/mo, $590/yr) — wired into the pricing page's "Go VIP"
# checkout button and the Paddle webhook's tier detection. VIP's differentiator
# is personal room feng shui (Bagua zone mapping), not "more of the same."
NEXT_PUBLIC_PADDLE_VIP_PRICE_ID=
NEXT_PUBLIC_PADDLE_VIP_ANNUAL_PRICE_ID=
# Secret API key — server-only, powers webhook signature verification.
PADDLE_API_KEY=
# Notification (webhook) destination secret for the endpoint pointing at
# /api/webhooks/paddle (starts with "pdl_ntfset_" or similar).
PADDLE_WEBHOOK_SECRET=

# Google Analytics 4 Measurement ID (starts with "G-"). Leave unset and
# Analytics.tsx renders nothing — no script loads, no CSP surface added at
# runtime. Get this from analytics.google.com after creating a GA4 property
# for the site (Admin > Data Streams > your web stream > Measurement ID).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Shared secret guarding /api/emails/winback (there's no admin auth system
# yet, so this is a simple header check rather than nothing). Pick any long
# random string. Send win-back emails manually while tracking is still
# spreadsheet-level, e.g.:
#   curl -X POST https://<domain>/api/emails/winback \
#     -H "Content-Type: application/json" -H "x-admin-secret: <this value>" \
#     -d '{"email":"user@example.com","stage":"day14","fullName":"Alex"}'
ADMIN_EMAIL_SECRET=
